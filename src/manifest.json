{
  "manifest_version": 3,
  "name": "OC Pilot",
  "version": "0.25.18",
  "description": "Your OpenShift co-pilot: auto login, credential management, oc login command copying, and more.",
  "permissions": ["storage", "clipboardWrite", "offscreen", "scripting", "tabs", "alarms", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OC Pilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/oauth/authorize*",
        "*://*/login*",
        "*://*/oauth/token/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["*://*/k8s/*"],
      "js": ["content-console.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["*://*/k8s/*"],
      "js": ["content-console-rv.js"],
      "run_at": "document_end",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
